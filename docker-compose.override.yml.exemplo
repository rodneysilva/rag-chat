# docker-compose.override.yml — CÓPIE (sem o .exemplo) na máquina que roda o
# container DIFERENTE do dev local e ajuste. O compose mescla este arquivo
# AUTOMATICAMENTE (mesmo diretório, `docker compose up -d`); é git-ignored
# porque só vale para o host onde vive.
#
# CASO REAL — VPS de produção: o Qdrant corre no container `ragaroy-qdrant`
# do stack antigo (rede `rag-llama_default`) e a LLM/embed só são alcançáveis
# pelos TÚNEIS (llm/embed.disroy.org — o .env da VPS já traz essas URLs).
# Sem este override, o `environment:` do compose base (host.docker.internal,
# correto no dev da estação com Docker Desktop) VENCE o .env (override=False)
# e o container nasce apontando para um host que não existe lá.
#
# ⚠️ LIÇÃO (quedas de 502 pós-deploy): TODA rede de que o container precisa
# deve estar declarada AQUI. Ligação manual (`docker network connect`) morre
# no próximo `docker compose up -d` — o recreate monta só as redes do compose.
# Era o caso da traefik_net: rota pública rag.disroy.org -> ragchat-api:8000
# resolvida por NOME no traefik; sem a rede, 502 com a API de pé.
services:
  api:
    environment:
      # as chaves vêm do .env DESTA máquina (fonte única por host)
      QDRANT_URL: ${QDRANT_URL}
      LLM_BASE_URL: ${LLM_BASE_URL}
      EMBED_BASE_URL: ${EMBED_BASE_URL}
    networks:
      - default          # sandbox do próprio compose continua resolvendo
      - ragaroy          # rede do stack antigo (ragaroy-qdrant)
      - web              # traefik: roteia rag.disroy.org -> ragchat-api:8000
                         # POR NOME — sem esta rede o DNS falha e o site dá 502

networks:
  ragaroy:
    name: rag-llama_default
    external: true
  web:
    name: traefik_net
    external: true
